{
    "name": "eduksx/core",
    "description": "Gemeinsame Bausteine der EduKSX-Plattform für Laravel-Module (Fehler, Sicherheit, Datenbank, Listen, Prüfungen, Steckbrief, Ereignisse, Historie).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Markus Keller"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "opis/json-schema": "^2.6"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "laravel/pint": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "EduKSX\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduKSX\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduKSX\\Core\\CoreServiceProvider"
            ]
        },
        "eduksx": {
            "module": "core",
            "standards": {
                "db": "1.2.1",
                "api": "1.1.1"
            }
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "lint": "@php vendor/bin/pint --test",
        "ci:check": [
            "python3 .github/blueprint/release.py check",
            "@spec:check",
            "@lint",
            "@test"
        ],
        "spec:check": "@php bin/spec.php check"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
