{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "EduKSX S6 – Leitstand ↔ Instanz (Update-Dienst)",
    "version": "1.0.0",
    "description": "Schnittstelle des Leitstands (Modul `ops`) für isolierte Instanzen (Plattform S6). Verbindungen gehen nur von der Instanz aus. Heartbeat alle 15 Minuten ohne Inhalte und ohne Personendaten; Aufträge holt die Instanz ab. Aufträge sind signiert (JWS, Schlüssel des Leitstands); die Instanz prüft Signatur und Image-Digest vor der Ausführung.",
    "license": {
      "name": "GPL-3.0-or-later",
      "identifier": "GPL-3.0-or-later"
    },
    "x-eduksx-module": "ops",
    "x-eduksx-api-standard": "1.1"
  },
  "servers": [
    {
      "url": "https://ops.eduksx.ch"
    }
  ],
  "security": [
    {
      "clientCredentials": [
        "ops:instances.report"
      ]
    },
    {
      "instanceToken": []
    }
  ],
  "paths": {
    "/api/v1/instances/{instance_id}/heartbeat": {
      "post": {
        "operationId": "reportHeartbeat",
        "summary": "Zustand der Instanz melden",
        "security": [
          {
            "clientCredentials": [
              "ops:instances.report"
            ]
          },
          {
            "instanceToken": []
          }
        ],
        "x-eduksx-ability": "instance.report",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Heartbeat"
              },
              "example": {
                "module": "intranet",
                "version": "2.4.1",
                "status": "ok",
                "sent_at": "2026-11-13T19:30:00Z",
                "last_job": {
                  "job_id": "0193a1b2-7c4d-7e8f-9a0b-1c2d3e4f5a6b",
                  "result": "succeeded",
                  "finished_at": "2026-11-13T02:14:00Z"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Angenommen; nennt, ob Aufträge bereitliegen.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeartbeatAccepted"
                },
                "example": {
                  "jobs_pending": true,
                  "next_heartbeat_seconds": 900
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "422": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/v1/instances/{instance_id}/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "Offene Aufträge der Instanz abholen",
        "security": [
          {
            "clientCredentials": [
              "ops:jobs.read"
            ]
          },
          {
            "instanceToken": []
          }
        ],
        "x-eduksx-ability": "job.read",
        "parameters": [
          {
            "$ref": "#/components/parameters/InstanceId"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "eyJpZCI6IjAxOTMifQ"
          }
        ],
        "responses": {
          "200": {
            "description": "Offene Aufträge, älteste zuerst.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "403": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "429": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientCredentials": {
        "type": "oauth2",
        "description": "OAuth2 Client Credentials über Ident (Plattform S2) für Instanzen bei uns; selbst gehostete Instanzen nutzen instanceToken.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://ident.eduksx.ch/oauth/v2/token",
            "scopes": {
              "ops:instances.report": "Zustand melden",
              "ops:jobs.read": "Aufträge abholen"
            }
          }
        }
      },
      "instanceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Instanz-Token von ops (Präfix ops_inst_), ausgestellt bei der Registrierung mit Einladungscode; für selbst gehostete Instanzen ohne Ident (KONZEPT-LEITSTAND L4)."
      }
    },
    "parameters": {
      "InstanceId": {
        "name": "instance_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "0193a1b2-0000-7000-8000-000000000001"
      }
    },
    "responses": {
      "Problem": {
        "description": "Fehler nach API A6.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Status": {
        "enum": [
          "ok",
          "degraded",
          "fail"
        ]
      },
      "Heartbeat": {
        "type": "object",
        "required": [
          "module",
          "version",
          "status",
          "sent_at"
        ],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]{1,15}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "type": "object",
            "description": "Zusammenfassung aus /health, nur Status je Prüfung.",
            "additionalProperties": {
              "$ref": "#/components/schemas/Status"
            }
          },
          "last_job": {
            "type": "object",
            "required": [
              "job_id",
              "result",
              "finished_at"
            ],
            "additionalProperties": false,
            "properties": {
              "job_id": {
                "type": "string",
                "format": "uuid"
              },
              "result": {
                "enum": [
                  "succeeded",
                  "failed",
                  "rolled_back",
                  "skipped"
                ]
              },
              "finished_at": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      },
      "HeartbeatAccepted": {
        "type": "object",
        "required": [
          "jobs_pending"
        ],
        "additionalProperties": false,
        "properties": {
          "jobs_pending": {
            "type": "boolean"
          },
          "next_heartbeat_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 3600
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "type",
          "created_at",
          "signature"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": [
              "update",
              "backup",
              "restart"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "target_version": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$",
            "description": "Image nur mit Digest, aus der offiziellen Registry."
          },
          "maintenance_window": {
            "type": "object",
            "required": [
              "starts_at",
              "ends_at"
            ],
            "additionalProperties": false,
            "properties": {
              "starts_at": {
                "type": "string",
                "format": "date-time"
              },
              "ends_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$",
            "description": "JWS mit abgetrenntem Inhalt (RFC 7515 Anhang F) über den Auftrag ohne `signature`."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "update"
                }
              }
            },
            "then": {
              "required": [
                "target_version",
                "image",
                "maintenance_window"
              ]
            }
          }
        ]
      },
      "JobList": {
        "type": "object",
        "required": [
          "data",
          "has_more"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
