{
  "$comment": "Gemeinsame Schemas der EduKSX-Plattform (API-Standard D3) aus eduksx/core. In die Beschreibung des Moduls unter components übernehmen (eine eigenständige Datei ohne externe Verweise).",
  "schemas": {
    "Problem": {
      "type": "object",
      "description": "Fehler nach RFC 9457 (API-Standard A6).",
      "required": ["type", "title", "status", "code", "request_id"],
      "properties": {
        "type": { "type": "string", "format": "uri", "example": "https://docs.eduksx.ch/problems/validation_failed" },
        "title": { "type": "string", "example": "Unprocessable Content" },
        "status": { "type": "integer", "example": 422 },
        "detail": { "type": "string", "example": "Die Anfrage enthält ungültige Werte." },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$", "example": "validation_failed" },
        "instance": { "type": "string", "example": "/api/v1/terms" },
        "request_id": { "type": "string", "example": "01JCX7Q3M5V8YB2D4N6P9R1T3W" },
        "errors": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } },
          "example": { "name": ["Das Feld ist erforderlich."] }
        }
      }
    },
    "CursorMeta": {
      "type": "object",
      "description": "Cursor-Pagination (API-Standard A5).",
      "required": ["limit", "next_cursor", "has_more"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 200, "example": 50 },
        "next_cursor": { "type": ["string", "null"], "example": "eyJjIjp7fX0" },
        "has_more": { "type": "boolean", "example": true }
      }
    },
    "CursorLinks": {
      "type": "object",
      "required": ["next"],
      "properties": {
        "next": { "type": ["string", "null"], "format": "uri", "example": "https://glossary.example/api/v1/terms?cursor=eyJjIjp7fX0" }
      }
    }
  },
  "parameters": {
    "cursor": { "name": "cursor", "in": "query", "description": "Undurchsichtiger Cursor aus meta.next_cursor.", "schema": { "type": "string" }, "example": "eyJjIjp7fX0" },
    "limit": { "name": "limit", "in": "query", "description": "Einträge je Seite (Vorgabe 50, höchstens 200).", "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 }, "example": 50 },
    "sort": { "name": "sort", "in": "query", "description": "Sortierung, Minus = absteigend.", "schema": { "type": "string" }, "example": "name,-published_at" }
  },
  "responses": {
    "Problem": {
      "description": "Fehler",
      "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
    }
  }
}
